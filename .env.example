# Flask Configuration
SECRET_KEY=replace_me_in_production_with_random_string

# OpenRouter API — для пайплайна генерации задач Адаптивного теста
# Получить ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_SITE_URL=https://formyla.ru

# Модели пайплайна (опционально, есть дефолты)
# ADAPTIVE_GENERATOR_MODEL=deepseek/deepseek-chat
# ADAPTIVE_VALIDATOR_MODEL=anthropic/claude-sonnet-4
# ADAPTIVE_CALIBRATOR_MODEL=openai/gpt-4o
# ADAPTIVE_MAX_ITER=4
# ADAPTIVE_MAX_COST_USD=5.0

# ─── Daily Tasks (Задачи дня) — мульти-LLM пайплайн ───────────────
# Пайплайн использует OpenRouter для всех трёх нейросетей (Gemini → Opus → GPT),
# поэтому достаточно одного ключа OPENROUTER_API_KEY (см. выше).
#
# Опциональные переопределения (если не заданы — используются дефолты из кода):
# DAILY_TASKS_MAX_ITERATIONS=3   # макс. число итераций Opus-fix → GPT-audit
# DAILY_TASKS_BUDGET_USD=2.0     # бюджет на одну генерацию (не реализовано)
# DAILY_TASKS_TIMEOUT_SECONDS=180
# DAILY_TASKS_BACKEND=thread     # thread | celery | rq

# DeepSeek API (for content generation)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OdiRouter API (https://odirouter.ai) — OpenAI-compatible endpoint.
# Ключ: https://odirouter.ai/dashboard → API keys
# Base URL для OpenAI-совместимых SDK: https://api.odirouter.ai/v1
# ODIROUTER_API_KEY=sk-your_key_here
# ODIROUTER_BASE_URL=https://api.odirouter.ai/v1
# Модель генерации изображений: nano-banana-2

# Gemini vision — распознавание фото решений (через OdiRouter OpenAI-compatible endpoint).
# Ключ работает на https://api.odirouter.ai/v1, модель по умолчанию gemini-3.7-flash.
# GEMINI_API_KEY=sk-your_key_here
# GEMINI_API_BASE=https://api.odirouter.ai/v1
# GEMINI_VISION_MODEL=gemini-3.7-flash

# ─── AI-наставник визуального атласа методов ────────────────────────
# Наставник атласа (/api/tutor/chat) — изолированный провайдер-слой.
# Ключ живёт ТОЛЬКО на сервере и никогда не попадает в HTML/JS.
# Если ATLAS_TUTOR_API_KEY не задан — используется DEEPSEEK_API_KEY.
#
# ATLAS_TUTOR_API_BASE=https://api.deepseek.com/v1   # OpenAI-compatible base
# ATLAS_TUTOR_API_KEY=sk-your_key_here
# ATLAS_TUTOR_MODEL=deepseek-v4-flash                # текстовая модель
# ATLAS_TUTOR_VISION_MODEL=deepseek-v4-flash-vision-exp  # для фото/скриншотов
# ATLAS_TUTOR_TIMEOUT=60
# ATLAS_TUTOR_MAX_IMAGES=4
# ATLAS_TUTOR_MAX_IMAGE_BYTES=6291456

# --- Kimi K2.5 --- vision model for solution review
KIMI_API_KEY=
KIMI_MODEL=

# ─── Email Configuration (Resend) ───────────────────────────────────
# Provider: Resend (https://resend.com). Free tier: 3000 emails/month.
# Gmail SMTP is no longer supported — Google revokes App Passwords for the
# project account (SMTPAuthenticationError 535 "BadCredentials"). Do NOT
# attempt to put a Gmail App Password here, it will be rejected.
#
# Setup (one-time):
#   1) Create account at https://resend.com (GitHub OAuth works).
#   2) API Keys → Create → copy ``re_xxxxxxxxxxxxx``.
#   3) Domains → either verify your own (Resend will show the SPF + DKIM
#      records to add to your DNS zone), or skip and use the sandbox sender
#      ``onboarding@resend.dev`` (works without DNS, but for testing only —
#      Gmail will mark such mail as "via resend.dev").
#
# ── Variant A: HTTP API (recommended) ──
# Set just these two — utils/mail.py calls Resend over HTTPS, no SMTP.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
MAIL_DEFAULT_SENDER=noreply@formyla.com

# ── Variant B: SMTP (Flask-Mail) ──
# Use ONLY if you can't use the HTTP API for some reason. Resend SMTP:
#   host=smtp.resend.com, port=465, SSL=True, user=resend, pass=<api_key>
# Note: username is the literal string "resend", NOT an email address.
# MAIL_SERVER=smtp.resend.com
# MAIL_PORT=465
# MAIL_USE_SSL=True
# MAIL_USE_TLS=False
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxx

# Где принимать обращения и отзывы (если не задано — берётся MAIL_DEFAULT_SENDER)
SUPPORT_NOTIFY_EMAIL=
REVIEW_NOTIFY_EMAIL=

# Yandex OAuth
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
DOMAIN_URL=http://localhost:5000

# Admin Routes Protection
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SEED_ADMIN_TOKEN=change-me-to-random-64-chars

# ─── Infrastructure Services ────────────────────────────────────────

# Sentry — отлов ошибок и трейсинг производительности
# TODO: получить на https://sentry.io → создать проект Flask
SENTRY_DSN=

# Brevo (Sendinblue) — устаревший канал, оставлен на случай миграции обратно
# (основной канал теперь Resend, см. выше).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@formyla.com

# Telegram Login Widget — авторизация через Telegram
# TODO: @BotFather → /newbot → FormylaMathsBot, /setdomain → formyla.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=FormylaMathsBot

# Plausible Analytics — приватная аналитика без cookies
# TODO: plausible.io → Add site → formyla.com
PLAUSIBLE_DOMAIN=

# Render / git release tag (для Sentry release tracking, выставляется автоматически на Render)
# RENDER_GIT_COMMIT=
# FLASK_ENV=production

# ─── Web Push Notifications (VAPID) ──────────────────────────────────
# Сгенерировать ключи: python _archive/_gen_vapid.py
# После генерации скопировать VAPID_PUBLIC_KEY и VAPID_PRIVATE_KEY сюда.
# VAPID_PUBLIC_KEY=your_vapid_public_key_here
# VAPID_PRIVATE_KEY=your_vapid_private_key_here
# VAPID_CLAIM_EMAIL=noreply@formyla.com

# ─── LiveKit Cloud (видеоконференции) ───────────────────────────────
# Получить: https://cloud.livekit.io → Create project → Keys
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=APIabc123...
# LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ─── DB Upload Token ────────────────────────────────────────────────
# Токен для защищённых админ-ручек загрузки/выгрузки БД
# DB_UPLOAD_TOKEN=change-me-to-random-string

# ─── Handwriting AI Models (опционально) ────────────────────────────
# HANDWRITING_AI_MODEL=anthropic/claude-3.5-haiku
# HANDWRITING_OCR_MODEL=anthropic/claude-opus-4.7

# ─── Drawing Diagnostics (опционально) ──────────────────────────────
# DRAWING_DIAG_TOKEN=
# DRAWING_CRITIC_ENABLED=
# DRAWING_ARCHITECT=
# DRAWING_COSMETIC_CRITIC=

# ─── Admin Emails (через запятую) ───────────────────────────────────
# ADMIN_EMAILS=admin@formyla.com

# ── BILLING_V1 (ЮKassa) ─────────────────────────────────────────
BILLING_AUTOREG=1                  # 0 — blueprint не регистрируется вовсе
BILLING_CREATE_ENABLED=0           # 1 — разрешить создание платежей (webhook работает всегда)
FAMILY_TEACHER_PLANS_ENABLED=0
FAMILY_MONTH_PRICE_KOP=0           # 0 = не продаётся
TEACHER_MONTH_PRICE_KOP=0
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_MODE=live                 # live | test; при live тестовые платежи не дают доступ
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_TIMEOUT_SEC=10
YOOKASSA_WEBHOOK_IP_CHECK=1        # 0 только локально
YOOKASSA_WEBHOOK_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11,77.75.156.35,77.75.154.128/25,2a02:5180::/32
PUBLIC_BASE_URL=https://formyla.net
YANDEX_METRIKA_ID=
FOUNDER_GRANT_UNTIL=2027-01-31T21:00:00Z   # = 01.02.2027 00:00 МСК

# ── FOUNDERS_V1 (Основатели) ──────────────────────────────────────
FOUNDER_CUTOFF_AT=2026-11-02T21:00:00Z    # = 03.11.2026 00:00 МСК (граница Основателей)
FOUNDER_EXCLUDE_USER_IDS=                  # ручные исключения (id через запятую), без пробелов
# FOUNDER_GRANT_UNTIL уже задан в блоке BILLING_V1 выше

# ── AB_V1 / LIMITS_V1 (A/B-группы и мягкие лимиты) ────────────────
PAYWALL_MODE=off                     # off | experiment | rollout (дефолт off)
PAYWALL_PREVIEW_ADMINS=0             # 1 — предпросмотр платной версии ТОЛЬКО для админов (при PAYWALL_MODE=off)
PAYWALL_START_AT=2026-11-02T21:00:00Z  # = 03.11.2026 00:00 МСК (старт платной версии)
PAYWALL_EXPERIMENT_ID=limits_v1
PAYWALL_AB=50                        # доля новых назначений (на старые группы не влияет)
AB_AUTOREG=1                         # 0 — не регистрировать CLI flask ab-report
AB_EXCLUDE_USER_IDS=                 # ручные исключения из эксперимента (id через запятую)
LIMITS_AUTOREG=1                     # 0 — не вешать хук лимитов на /api/tutor/send
FREE_TASKS_PER_DAY=3
FREE_AI_PER_DAY=1

# ── LAUNCH_V1 (дашборд запуска, промпт 29) ────────────────────────
ADMIN_LAUNCH_ENABLED=0               # 1 — включить /admin/launch (только админ)
LAUNCH_MIN_ELIGIBLE=150              # минимум назначенных на группу для правила 11.11
