егулярные графы", "комбинаторный подсчёт"], "diversity_signature": {"core_method": "циклический выбор без соседних", "secondary_method": "формула n/(n-k)*C(n-k,k)", "problem_form": "число независимых множеств на цикле", "object_type": "циклически упорядоченное множество", "solution_structure": "формула для циклического расположения", "key_idea": "учёт замыкания в круг", "answer_type": "целое число", "numerical_pattern": "105"}, "generator_model": "claude-opus-5", "solver_model": "claude-opus-5", "critic_model": "claude-opus-5", "quality_status": "APPROVE", "verification": "python-verified", "origin": "opus-replacement-L4", "old_level": null}
