ча на нахождение угла", "object_type": "треугольник с точкой на стороне", "solution_structure": "BDC равнобедренный → равносторонний → угол ABD через смежный", "key_idea": "BD=DC делает BDC равнобедренным с углом при основании C=60°, значит равносторонним", "answer_type": "угол (градусы)", "numerical_pattern": "20°"}, "generator_model": "source", "solver_model": null, "critic_model": null, "quality_status": "APPROVE", "verification": {"status": "PASS", "note": "вычислено: C=60°, BDC равносторонний, ADB=120°, ABD=180−40−120=20°; проверка 20+60=80=B"}, "origin": "remapped_4level", "old_level": 4}
