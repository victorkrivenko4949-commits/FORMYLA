 "2^k-1"}, "generator_model": "source", "solver_model": null, "critic_model": null, "quality_status": "APPROVE", "verification": {"answer_check": "PASS", "computational_check": "PASS", "note": "перебор k=1..4 даёт 1,3,7,15 = 2^k-1; для k=10 => 1023"}, "origin": "remapped_4level", "old_level": 5}
