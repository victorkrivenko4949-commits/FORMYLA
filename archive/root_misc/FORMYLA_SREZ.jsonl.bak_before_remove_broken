m_form": "текстовая задача на движение", "object_type": "три пристани на рукавах реки", "solution_structure": "исключение одного случая + два возможных варианта", "key_idea": "если после слияния стоит A — ответ 24 мин; если C — 72 мин; B невозможно", "answer_type": "два значения", "numerical_pattern": "24 и 72"}, "generator_model": "source", "solver_model": null, "critic_model": null, "quality_status": "APPROVE", "verification": {"status": "PASS", "computational_check": "PASS", "note": "проверена арифметика обоих случаев: 30/3=10, 18−10=8, 3·8=24; 18/3=6, 30−6=24, 3·24=72"}, "origin": "remapped_4level", "old_level": 4}
{"task_uid": "GEN-fill_0346", "grade": 7, "level": 3, "level_name": "региональный-лёгкий (сильный муниципал)", "section": "Текстовые задачи", "theme_id": "G7_T05", "theme": "Задачи на движение", "statement": "Моторная лодка и плот одновременно отправились из одного и того же пункта вниз по течению реки. Скорость моторной лодки в стоячей воде в 4 раза больше скорости течения. Лодка шла вниз по течению 2 часа, после чего мгновенно развернулась и пошла вверх по течению до встречи с плотом. Через сколько часов после начала движения лодка встретится с плотом?", "answer": "4 часа", "solution": "Пусть u — скорость течения (и скорость плота), тогда собственная скорость лодки v = 4u.\nСкорость лодки по течению равна v + u = 5u, против течения — v − u = 3u.\nЗа 2 часа лодка прошла вниз по течению расстояние 5u·2 = 10u, а плот за то же время проплыл u·2 = 2u. Значит, в момент разворота расстояние между лодкой и плотом равно 10u − 2u = 8u.\nПосле разворота лодка идёт вверх по течению (назад), а плот продолжает двигаться вниз; они сближаются со скоростью 3u + u = 4u.\nВремя до встречи после разворота: 8u / 4u = 2 часа.\nИтого с момента старта прошло 2 + 2 = 4 часа.\nПроверка: за 4 часа плот проплыл u·4 = 4u от старта; лодка за 2 часа вниз ушла на 10u, а за 2 часа вверх прошла 3u·2 = 6u, то есть оказалась в 10u − 6u = 4u от старта — координаты совпали.\nОтвет: 4 часа.", "methods": ["Относительное движение", "Метод расстояний"], "tags": ["движение по реке", "погоня", "относительная скорость"], "diversity_signature": {"core_method": "Относительное движение двух тел с разворотом", "secondary_method": "Составление уравнения пути", "problem_form": "Задача на встречу после разворота", "object_type": "Лодка и плот на реке", "solution_structure": "Вычисление разрыва и скорости сближения", "key_idea": "Скорость сближения равна сумме скоростей при встречном движении", "answer_type": "Время", "numerical_pattern": "Целое 4"}, "generator_model": "perplexity-computer-reasoning", "solver_model"